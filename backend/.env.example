# Copy to backend/.env and fill in. Never commit the real .env.

# dev = local testing (sandbox payments, SMS codes printed in the console)
# prod = real service (requires SECRET_KEY, HTTPS, real providers)
ENV=dev

# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# SQLite for local use; PostgreSQL in production, e.g.
# DATABASE_URL=postgresql+psycopg://gotrajet:password@db-host:5432/gotrajet
DATABASE_URL=sqlite:///backend/data/gotrajet.db

# Public address of the site (used in links sent by SMS / email)
PUBLIC_URL=http://127.0.0.1:8000

# First admin account, created at start-up if it does not exist
ADMIN_EMAIL=admin@gotrajet.test
ADMIN_PASSWORD=change-me-now

# Business rules
COMMISSION_RATE=0.07
INSURANCE_FEE_MAD=10
CASH_TOPUP_TTL_HOURS=48
REQUIRE_VERIFIED_TRAVELER=true

# Payments: sandbox = simulated card charges and "simulate agency payment" buttons.
# live = only real provider confirmations (cash agency webhook, card provider) move money.
PAYMENT_MODE=sandbox
# Shared secret given to the cash agency network (Cash Plus / Wafacash) for webhook signatures
CASH_WEBHOOK_SECRET=

# SMS / WhatsApp: console (prints to the server log), twilio, or wati
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WATI_API_ENDPOINT=
WATI_API_TOKEN=

# Identity documents are stored here (never served publicly)
UPLOAD_DIR=backend/data/uploads

# ---- Security ----
# true ONLY when the server can be reached through Cloudflare alone (see docs/security.md)
TRUST_CLOUDFLARE=false
# Cloudflare Turnstile anti-robot check (free): dashboard → Turnstile → Add site
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Admins must use an authenticator app. Default: on when ENV=prod, off in dev. Uncomment to force.
# ADMIN_REQUIRE_2FA=true
# Optional: admin panel only from these IPs (office, VPN), comma-separated
ADMIN_ALLOWED_IPS=
# Optional: other sites allowed to call the API from a browser (e.g. https://www.gotrajet.ma)
ALLOWED_ORIGINS=
