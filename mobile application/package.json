{
  "name": "gotrajet-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "GOTRAJET mobile application: the GOTRAJET website packaged as an installable web app (PWA) and a native Android / iOS app with Capacitor.",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "serve": "npm run build && node scripts/serve.mjs",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "apk": "npm run sync && node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "typescript": "^5.9.3"
  }
}
